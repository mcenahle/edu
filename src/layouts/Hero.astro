---
import { Icon } from "astro-icon/components";
---

<div
  class="position-relative overflow-hidden p-3 p-md-5 m-md-3 text-center bg-body-tertiary"
>
  <div
    class="col-md-6 p-lg-5 mx-auto my-5"
    style="z-index: 1000; position: relative;"
  >
    <h1 class="display-3 fw-bold">mcenahle.edu.pl</h1>
    <h3 class="fw-normal text-muted mb-3">个人学习教育网站，非大学网站</h3>
    <div class="d-flex gap-3 justify-content-center lead fw-normal">
      <a class="icon-link" href="/my/">
        <u>了解我</u>
        <Icon name="bi:chevron-right" class="icons" />
      </a>
      <a class="icon-link" href="/my-teacher-path/">
        <u>未来我的教师道路</u>
        <Icon name="bi:chevron-right" class="icons" />
      </a>
    </div>
  </div>
  <div class="product-device shadow-sm d-none d-md-block"></div>
  <div class="product-device product-device-2 shadow-sm d-none d-md-block">
  </div>
</div>
