---
import { Icon } from "astro-icon/components";
import Verified from "../assets/Verified.svg";
import Privacy from "../assets/Privacy.svg";
---

<footer class="py-5" style="border-top: 0.5px solid;">
  <div class="container">
    <div class="row">
      <div class="col-12 col-md">
        <a href="/" aria-label="mcenahle EDU">
          <img
            style="max-width: 24px;"
            src="/favicon.ico"
            alt="mcenahle.edu.pl"
          />
        </a>
        <small
          class="d-block text-body-secondary"
          style="line-height: 1.6em; margin-top: 8px;"
          ><b>© 2026 mcenahle.edu.pl.</b></small
        >
        <small
          class="d-block mb-2"
          style="line-height: 1.4em; margin-top: 6px; color: #b48a08;"
          ><Verified /> An offical website of the mcenahle edu ecosystem.</small
        >
        <small
          class="d-block mb-3 text-body-secondary"
          style="line-height: 1.4em; margin-top: 6px;"
          >Student · Developer · Student Researcher · Medicine, Nursing &
          Biology Enthusiast | CCF Professional Member</small
        >
      </div>
      <div class="col-6 col-md">
        <h5>学习和学术相关</h5>
        <ul class="list-unstyled text-small" style="line-height: 1.8em;">
          <li>
            <a class="link-secondary text-decoration-none" href="/cet-6/"
              ><u>英语六级</u></a
            >
          </li>
          <li>
            <a class="link-secondary text-decoration-none" href="/biology/"
              ><u>生物学</u></a
            >
          </li>
          <li>
            <a class="link-secondary text-decoration-none" href="/research/"
              ><u>个人迷你小论文</u></a
            >
          </li>
        </ul>
      </div>
      <div class="col-6 col-md">
        <h5>关于本网站</h5>
        <ul class="list-unstyled text-small" style="line-height: 1.8em;">
          <li>
            <a
              class="link-secondary text-decoration-none"
              href="https://github.com/mcenahle/edu/"
              target="_blank"><u>源代码</u> <Icon name="mdi:open-in-new" /></a
            >
          </li>
          <li>
            <a
              class="link-secondary text-decoration-none"
              href="/privacy-policy/"><Privacy /> <u>隐私声明</u></a
            >
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>
