---
const pathname = Astro.url.pathname;

const isActive = (path: string) =>
  pathname === path || pathname.startsWith(`${path}/`);

import { Icon } from "astro-icon/components";
---

<nav
  class="navbar navbar-expand-md bg-dark sticky-top border-bottom"
  data-bs-theme="dark"
>
  <div class="container">
    <a class="navbar-brand d-md-none" href="/">
      <img style="max-width: 24px" src="/favicon.ico" alt="mcenahle.edu.pl" />
      <span style="margin-left: 4px;">mcenahle EDU</span>
    </a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="offcanvas"
      data-bs-target="#offcanvas"
      aria-controls="offcanvas"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div
      class="offcanvas offcanvas-end"
      tabindex="-1"
      id="offcanvas"
      aria-labelledby="offcanvasLabel"
    >
      <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="offcanvasLabel">
          <a href="/" style="color: white;">mcenahle EDU</a>
        </h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="offcanvas"
          aria-label="Close"></button>
      </div>
      <div class="offcanvas-body">
        <ul class="navbar-nav flex-grow-1 justify-content-between">
          <li class="nav-item">
            <a class="nav-link" href="/" aria-label="mcenahle EDU">
              <img
                style="max-width: 24px"
                src="/favicon.ico"
                alt="mcenahle.edu.pl"
              />
            </a>
          </li>
          <li class="nav-item">
            <a
              class={`nav-link ${isActive("/cet-6") ? "active" : ""}`}
              href="/cet-6/">英语六级准备</a
            >
          </li>
          <li class="nav-item">
            <a
              class={`nav-link ${isActive("/biology") ? "active" : ""}`}
              href="/biology/">生物学</a
            >
          </li>
          <li class="nav-item">
            <a
              class={`nav-link ${isActive("/posts") ? "active" : ""}`}
              href="/posts/">相关文章</a
            >
          </li>
          <li class="nav-item">
            <a
              class={`nav-link ${isActive("/research") ? "active" : ""}`}
              href="/research/">个人迷你小论文</a
            >
          </li>
          <li class="nav-item dropdown">
            <a
              class="nav-link dropdown-toggle"
              href="javascript:void(0)"
              role="button"
              data-bs-toggle="dropdown"
              aria-expanded="false">外部链接</a
            >
            <ul
              class="dropdown-menu m-0 border-0 shadow-sm p-2 dropdown-menu-end"
            >
              <li>
                <a
                  class="dropdown-item px-3 py-2 rounded"
                  href="https://orcid.org/0009-0009-8499-4500"
                  target="_blank"
                  ><img
                    src="https://orcid.org/sites/default/files/images/orcid_16x16.png"
                    style="width: 1em;"
                    alt="ORCID iD icon"
                  /> My orcid ID <Icon name="mdi:open-in-new" /></a
                >
              </li>
              <li>
                <a
                  class="dropdown-item px-3 py-2 rounded"
                  href="https://mail.mcenahle.edu.pl/"
                  target="_blank">edu webmail <Icon name="mdi:open-in-new" /></a
                >
              </li>
            </ul>
          </li>
          <li class="nav-item">
            <a
              class="nav-link"
              href="https://github.com/mcenahle/edu/"
              target="_blank"
              aria-label="GitHub"
            >
              <Icon name="mdi:github" /> 查看本网站源代码
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</nav>
