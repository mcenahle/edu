---
import Layout from "../../layouts/Layout.astro";

import { Icon } from "astro-icon/components";

const title = "2026年小学教资科目一";
---

<Layout title={title}>
  <div class="mywords">
    <h2>{title}</h2>

    <div class="alert alert-success" role="alert">
      <b><Icon name="mdi:access-time" /> 教资分数将于 11 月 6 日 10:00 公布。</b
      >
      <hr />
      查看 <a
        href="https://ntce-countdown.mcenahle.chatgpt.site/"
        target="_blank"
      >
        <u>教资出分倒计时</u> <Icon name="mdi:open-in-new" /></a
      >、或者 <a
        class="btn btn-success"
        href="https://ntce.neea.edu.cn/ntce/"
        target="_blank"
        role="button"
        ><Icon name="mdi:search" />&nbsp;
        <u>查询教资分数</u>&nbsp;
        <Icon name="mdi:open-in-new" /></a
      >。
    </div>

    <iframe
      src="/pdfjs/web/viewer.html?file=/documents/2026年下半年教师资格证考试《综合素质》（小学）.pdf"
      class="pdfjs my-2"></iframe>
  </div>
</Layout>
