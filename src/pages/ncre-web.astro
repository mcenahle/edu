---
import Layout from "../layouts/Layout.astro";

import { Icon } from "astro-icon/components";

const title = "计算机二级（Web）模考";
---

<Layout title={title}>
  <div class="container">
    <h2>{title}</h2>
    <p>
      计算机二级（Web）将于2027-03-27开始。那么为了准备该考试，拟定进行数次模考。
    </p>

    <p>由于准备报考web，故主要备考手段为持续建设网站项目和 JavaScript。</p>

    <div class="ucla-table__responsive" style="margin-top: 12px;">
      <table class="ucla-table ucla-table__border">
        <thead>
          <tr>
            <th>考次</th>
            <th>考试日期</th>
            <th>考试试卷</th>
            <th>成绩查询</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>第一次（摸底考试）</td>
            <td>2026-9-24 14:00-16:00</td>
            <td><i>待定</i></td>
            <td><i>不存在</i></td>
          </tr>
          <tr>
            <td>第二次</td>
            <td><i>待定</i></td>
            <td><i>待定</i></td>
            <td><i>不存在</i></td>
          </tr>
          <tr>
            <td>第三次</td>
            <td><i>待定</i></td>
            <td><i>待定</i></td>
            <td><i>不存在</i></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</Layout>
