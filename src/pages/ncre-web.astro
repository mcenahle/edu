---
import Layout from "../layouts/Layout.astro";

import { Icon } from "astro-icon/components";

const title = "计算机二级（Web）模考";
---

<Layout title={title}>
  <div class="container">
    <h2>{title}</h2>
    <p>
      计算机二级（Web）将于2027-03-27开始。那么为了准备该考试，拟定进行数次模考。
    </p>

    <p>
      具体开始模考时间至少于2026年11月开始。但由于准备报考web，故主要备考手段为持续建设网站项目和
      JavaScript。
    </p>
  </div>
</Layout>
