---
import Layout from "../../layouts/Layout.astro";

import { Icon } from "astro-icon/components";

const title = "英语六级模考";
---

<Layout title={title}>
  <div class="mywords">
    <h2>{title}</h2>
    <p>
      英语六级下次考试将于2026-12-12下午开始。那么为了准备该考试，拟定进行数次模考。
    </p>

    <div style="margin-top: 12px;">
      <table class="table table-striped">
        <thead>
          <tr>
            <th>考次</th>
            <th>考试日期</th>
            <th>考试试卷</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><a href="202610/"><u>第一次</u></a></td>
            <td><i>暂定2026-10-21下午/22下午</i></td>
            <td
              ><i>待定，目前暂定为语法专项试卷</i>。<a href="english-tenses/"
                ><u>英语时态表</u></a
              ></td
            >
          </tr>
          <tr>
            <td>第二次</td>
            <td>2026-11-?</td>
            <td><i>待定</i></td>
          </tr>
          <tr>
            <td>第三次</td>
            <td>2026-12-?</td>
            <td><i>待定</i></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="alert alert-primary" role="alert" style="margin-top: 12px;">
      <b>获取 CET 准考证时间</b>
      <hr />
      12月1日9时起，完成CET笔试报名及缴费的考生可 <a
        href="https://cet-bm.neea.edu.cn/Home/QuickPrintTestTicket"
        target="_blank"
        ><u>登录CET报名网站</u> <Icon name="mdi:open-in-new" /></a
      > 下载、打印笔试准考证。
    </div>
  </div>
</Layout>
